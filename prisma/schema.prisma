// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  studyCourses StudyCourse[]
  memoryCards MemoryCard[]
  memoryReviews MemoryReview[]
  studySettings StudySettings?
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model ErrorItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  examSummary      String? // 考研速记：本题最值得记忆的核心结论/公式/判定条件
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  
  createdAt DateTime @default(now())
}

model StudyCourse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  subjectKey  String?
  examYear    Int?
  chapters    StudyChapter[]
  cards       MemoryCard[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model StudyChapter {
  id        String      @id @default(cuid())
  courseId  String
  course    StudyCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  order     Int         @default(0)
  cards     MemoryCard[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([courseId, name])
  @@index([courseId, order])
}

model StudySettings {
  userId              String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyNewLimit       Int      @default(20)
  dailyReviewLimit    Int      @default(100)
  relearnMinutes      Int      @default(10)
  initialGoodDays     Int      @default(1)
  initialEasyDays     Int      @default(4)
  hardMultiplier      Float    @default(1.2)
  easyMultiplier      Float    @default(1.3)
  maxIntervalDays     Int      @default(365)
  examDate            DateTime?
  timezone            String   @default("Asia/Shanghai")
  theme               String   @default("system")
  defaultsInitialized Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MemoryCard {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        StudyCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId     String?
  chapter       StudyChapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  title         String
  cardType      String        @default("basic") // basic, translation, formula, cloze, condition, compare
  prompt        String
  answer        String
  explanation   String?
  conditions    String?
  pitfalls      String?
  formula       String?
  roc           String?
  precautions   String?
  steps         String?
  initialConditions String?
  finalConditions String?
  chinese       String?
  english       String?
  letterType    String?
  paragraphPosition String?
  sentenceFunction String?
  clozeText     String?
  comparison    String?
  sentences     String?
  slots         String?
  tags          String?       // JSON array for flexible import/export
  source        String?
  notes         String?
  dueAt         DateTime      @default(now())
  lastReviewedAt DateTime?
  intervalDays  Float         @default(0)
  easeFactor    Float         @default(2.5)
  repetitions   Int           @default(0)
  lapses        Int           @default(0)
  suspended     Boolean       @default(false)
  reviews       MemoryReview[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, dueAt])
  @@index([courseId, chapterId])
}

model MemoryReview {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String
  card          MemoryCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating        String      // again, hard, good, easy
  mode          String      @default("recall")
  previousDueAt DateTime?
  nextDueAt     DateTime?
  responseMs    Int?
  responseText  String?
  clientEventId String?
  note          String?
  reviewedAt    DateTime    @default(now())
  reviewOrder   Int         @default(0) // Per-card serialization order for equal observed timestamps.

  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
  @@unique([userId, clientEventId])
}
